__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
*.so

# Virtual environments
.venv/
venv/
env/
.env

# ============================================================
# Jupyter / IPython
# ============================================================
.ipynb_checkpoints/
*.ipynb_checkpoints

# ============================================================
# R
# ============================================================
.Rhistory
.RData
.Rproj.user/
*.Rcheck/

# ============================================================
# Experiment logs (run-specific, not for distribution)
# ============================================================
# All run logs — covers longitudinal, hparam, cross_animacy subfolders
logs/

# ============================================================
# Trained intervention weights
# Weights are large and machine-specific; re-train from scratch
# ============================================================
intervention_models/

# ============================================================
# Raw experiment results & run-specific CSVs
# Pre-computed parquets in results/ are kept for reproducibility,
# but raw per-run CSVs and intermediate outputs are excluded.
# ============================================================

# Raw per-seed CSV outputs produced by generalization.py
results/generalization/**/*.csv
results/generalization/**/eval_data/

# Old / intermediate result snapshots
results/old/
results/atrey/old/

# Summary CSVs that are regenerated by process_*.py
# (the .parquet files ARE kept — they are the pre-computed outputs)
results/summary.csv
results/summary_animate.csv
results/summary_inanimate.csv
results/hparam_summary.csv
results/cross_animacy_summary.csv
results/cross_animacy_boost.csv
results/atrey/summary.csv
results/atrey/summary_animate.csv
results/atrey/summary_inanimate.csv
results/atrey/hparam_summary.csv
results/atrey/cross_animacy_summary.csv
results/atrey/cross_animacy_boost.csv

# ============================================================
# HuggingFace / model cache
# ============================================================
.cache/
*.cache
huggingface/
# HF hub cache if accidentally placed in repo
hub/
models/

# ============================================================
# OS / editor artifacts
# ============================================================
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/
*.code-workspace

# ============================================================
# SLURM / cluster artifacts
# ============================================================
slurm-*.out
slurm-*.err
*.sbatch.lock
core.*

# ============================================================
# Large binary / data files
# ============================================================
*.bin
*.pt
*.pth
*.ckpt
*.safetensors
*.arrow
*.jsonl
# Keep .parquet (pre-computed results) — explicitly override below
# Keep .csv in analysis/figures/

# ============================================================
# Generated figures (can be reproduced by running R scripts)
# ============================================================
analysis/figures/**/*.pdf
analysis/figures/**/*.png
analysis/figures/**/*.svg
# But keep the .gitkeep placeholders that mark the directories
!analysis/figures/**/.gitkeep

# Stats output text files generated by R scripts (reproducible, not source)
analysis/figures/**/stats_output*.txt
